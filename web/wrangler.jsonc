// Cloudflare Worker: liefert die statische Seite aus `out/` aus; worker/index.ts beantwortet zusätzlich
// /api/seats (freie Plätze nach Anmeldungen herunterzählen), leitet alte Wix-Adressen und www um und meldet
// fehlgeschlagene Builds per ntfy. Secrets SANITY_WRITE_TOKEN, NTFY_TOPIC und NTFY_TOKEN im Cloudflare-Dashboard
// setzen (Settings → Variables and Secrets), SANITY_PROJECT_ID unten nach dem Anlegen des Sanity-Projekts eintragen.
{
  "name": "verkraeutert",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /kurse → kurse.html
    "html_handling": "auto-trailing-slash",
    // unbekannte Adressen → out/404.html
    "not_found_handling": "404-page",
    // Jede Anfrage zuerst an den Worker: alte Wix-Adressen (/post/…, /über-uns, …) und www umleiten
    "run_worker_first": true
  },
  "vars": {
    "SANITY_PROJECT_ID": "TODO"
  },
  // Build-Benachrichtigung per ntfy: erst einschalten, wenn die Queue «verkraeutert-builds» im Dashboard existiert
  // (sonst schlägt der Deploy fehl):
  // "queues": { "consumers": [{ "queue": "verkraeutert-builds", "max_batch_size": 10, "max_batch_timeout": 5 }] },
  // Logs im Dashboard (Worker → Observability → Logs)
  "observability": { "enabled": true }
}
